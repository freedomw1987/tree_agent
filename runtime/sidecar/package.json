{
  "name": "@voice-agent/sidecar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "build": "npm --prefix ../relay run build && esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/main.mjs --packages=external",
    "pretest": "npm --prefix ../relay run build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@voice-agent/relay": "file:../relay"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vitest": "^2.1.8",
    "esbuild": "^0.24.0"
  }
}
