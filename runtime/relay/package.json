{
  "name": "@voice-agent/relay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.mjs",
  "scripts": {
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.mjs --packages=external"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1161.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "~5.7.2",
    "vitest": "^2.1.8",
    "esbuild": "^0.24.0"
  },
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./fakes": {
      "types": "./src/fakes.ts",
      "default": "./src/fakes.ts"
    }
  }
}
